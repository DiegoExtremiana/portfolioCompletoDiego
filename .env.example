# ─────────────────────────────────────────────────────────────
# Contact form — Vercel Serverless Function (api/contact.ts)
# Configure these in the Vercel dashboard: Project → Settings → Environment Variables.
# If they are NOT set, the contact form gracefully falls back to a mailto: link.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_email@gmail.com
# Gmail "app password" (NOT your normal password). https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
# Where contact messages are delivered:
CONTACT_TO=dextremiana1998@gmail.com

# ─────────────────────────────────────────────────────────────
# GitHub data fetch (build time) — optional
# A token only raises the API rate limit; the build works without it.
# ─────────────────────────────────────────────────────────────
# GITHUB_TOKEN=ghp_xxx
# GITHUB_USERNAME=DiegoExtremiana
