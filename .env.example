# Contact form (api/contact.ts). Set these in Vercel > Settings > Environment Variables.
# Without them the form falls back to a mailto: link.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_email@gmail.com
# Gmail app password, not your account password: https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
CONTACT_TO=dextremiana1998@gmail.com

# Build-time GitHub fetch (optional). A token only raises the API rate limit.
# GITHUB_TOKEN=
# GITHUB_USERNAME=DiegoExtremiana
